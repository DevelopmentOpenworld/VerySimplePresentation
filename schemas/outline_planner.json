{
  "$id": "vsp/schemas/outline_planner.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["slides", "skipped"],
  "properties": {
    "slides": {
      "type": "array", "minItems": 1, "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "fact_ids"],
        "properties": {
          "title": {"type": "string", "minLength": 1, "maxLength": 75},
          "fact_ids": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"type": "string", "pattern": "^f[0-9]{2,3}$"}}
        }
      }
    },
    "skipped": {
      "type": "array", "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fact_id", "reason"],
        "properties": {
          "fact_id": {"type": "string", "pattern": "^f[0-9]{2,3}$"},
          "reason": {"type": "string", "minLength": 1, "maxLength": 200}
        }
      }
    }
  }
}
