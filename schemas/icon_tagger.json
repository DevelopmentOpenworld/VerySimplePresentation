{
  "$id": "vsp/schemas/icon_tagger.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pictures"
  ],
  "properties": {
    "pictures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "picture",
          "kind",
          "meaning",
          "keywords"
        ],
        "properties": {
          "picture": {
            "type": "integer",
            "minimum": 1,
            "maximum": 24
          },
          "kind": {
            "type": "string",
            "enum": [
              "icon",
              "marker",
              "logo",
              "shape",
              "number",
              "other"
            ]
          },
          "meaning": {
            "type": "string",
            "maxLength": 60
          },
          "keywords": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            }
          }
        }
      }
    }
  }
}
