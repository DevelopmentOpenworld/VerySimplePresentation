{
  "$id": "vsp/schemas/speaker_notes.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["slides"],
  "properties": {
    "slides": {
      "type": "array", "minItems": 1, "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text"],
        "properties": {
          "id": {"type": "string", "pattern": "^(cover|[A-Za-z0-9_-]{1,40})$"},
          "text": {"type": "string", "minLength": 1, "maxLength": 1500}
        }
      }
    }
  }
}
